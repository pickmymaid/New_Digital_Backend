global
    log stdout format raw daemon
    maxconn 10000

    # ---- iPhone safe TLS ----
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tlsv13
    ssl-default-bind-ciphers ECDHE+AESGCM:ECDHE+CHACHA20
    
    tune.ssl.cachesize 100000
    tune.ssl.lifetime 600

defaults
    log global
    mode http
    option httplog
    timeout connect 5s
    timeout client  60s
    timeout server  60s

frontend fe_https
    bind *:443 ssl crt /etc/haproxy/certs/api-backendpickmymaid-prod.pem alpn http/1.1
    mode http
    default_backend be_api

backend be_api
    option http-keep-alive
    balance roundrobin
    server api1 node-server-prod:8080 check
